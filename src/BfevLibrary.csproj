<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>AcnhModding.BfevLibrary</PackageId>
    <Version>0.12.2-acnh.1</Version>
    <Title>BfevLibrary (ACNH Modding fork)</Title>
    <Authors>Arch Leaders</Authors>
    <Description>ACNH Modding fork of BfevLibrary with EventFlowToCode serialization fixes. Based on BfevLibrary by Arch Leaders and evfl by Léo Lam.</Description>
    <Copyright>(c) Arch Leaders</Copyright>
    <PackageProjectUrl>https://github.com/acnhmodding/BfevLibrary</PackageProjectUrl>
    <PackageReadmeFile>ReadMe.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/acnhmodding/BfevLibrary</RepositoryUrl>
    <PackageTags>bfevfl;evfl;event flows;botw;nintendo;zelda</PackageTags>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageIcon>icon.png</PackageIcon>
    <NoWarn>8618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\ReadMe.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
